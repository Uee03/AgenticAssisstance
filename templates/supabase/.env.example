# Copy to .env (git-ignored). CLIENT-safe values may be shipped to the browser/app; SERVER-only must NOT.

# --- Client-safe (anon) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- SERVER ONLY — never send to a client, never commit real values ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=CHANGEME
SUPABASE_JWT_SECRET=CHANGEME
