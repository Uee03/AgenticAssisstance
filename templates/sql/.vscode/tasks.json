{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db up (postgres)",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "problemMatcher": []
    },
    {
      "label": "db up (sql server)",
      "type": "shell",
      "command": "docker compose up -d mssql",
      "problemMatcher": []
    },
    {
      "label": "db down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "psql shell",
      "type": "shell",
      "command": "docker compose exec postgres psql -U ${POSTGRES_USER:-app} -d ${POSTGRES_DB:-app}",
      "problemMatcher": []
    },
    {
      "label": "sqlcmd shell",
      "type": "shell",
      "command": "docker compose exec mssql /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -No",
      "problemMatcher": []
    }
  ]
